{
	"compilerOptions": {
		"jsx": "react-jsx",
		"moduleResolution": "Bundler",
		"module": "ESNext",
		"target": "ES2022",
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"paths": {
			"@/*": ["./src/*"],
			"content-collections": ["./.content-collections/generated"]
		}
	},
	"include": [
		"src",
		"scripts",
		"./vite.config.ts",
		"./postcss.config.ts",
		"./content-collections.ts"
	]
}
